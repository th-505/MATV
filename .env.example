# Server only. Never put a Supabase secret in Flutter or web assets.
SUPABASE_URL=https://roqccichwszxamdpvhli.supabase.co
SUPABASE_SECRET_KEY=
# Legacy server key can be used instead of SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: server-side TMDb enrichment. Leave blank to disable extra TMDb requests.
TMDB_API_KEY=
TMDB_V4_TOKEN=

# Server-only Gemini media identity audit; never expose these in web/Flutter assets.
GEMINI_API_KEY=
GEMINI_API_KEY_BACKUP=
GEMINI_MODEL=gemini-2.5-flash
# Optional TMDB credential failover.
TMDB_API_KEY_OL=
TMDB_API_KEY_BP=

# Keep disabled until mitv_library.kind permits exploration and auth/player wiring is deployed.
EXPLORATION_LIBRARY_ENABLED=false
