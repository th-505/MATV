# =========================================================
# 1. منع رفع الملفات المضغوطة والنسخ الاحتياطية
# الهدف: الحفاظ على خفة المستودع ومنع تضخم حجمه
# =========================================================
*.zip
*.tar.gz
*.rar
*.7z
*.bak

# =========================================================
# 2. حماية ملفات البيئة والمفاتيح السرية (مهم جداً للأمان)
# الهدف: منع تسريب مفاتيح الذكاء الاصطناعي أو روابط السيرفرات السرية
# =========================================================
.env
.env.local
.env.*
!.env.example

# =========================================================
# 3. منع رفع ملفات الرموز التشخيصية الضخمة والمعرفات المؤقتة
# الهدف: توفير المساحة وتسريع أداة المراجعة الآلية
# =========================================================
*.symbols
app/.last_build_id

# =========================================================
# 4. تجاهل ملفات النظام ومحررات الأكواد (Windows / macOS / VSCode)
# =========================================================
.DS_Store
Thumbs.db
.idea/
.vscode/
__pycache__/
*.pyc

# =========================================================
# 5. مجلدات الاعتماديات وملفات البناء المؤقتة
# =========================================================
node_modules/
.dart_tool/
build/
flutter_app/.flutter-plugins-dependencies
supabase/.temp/
.wrangler/
.dev.vars
.dev.vars.*
