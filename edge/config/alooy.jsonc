{
  "name": "matv-extract-alooy",
  "main": "../src/provider.mjs",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "vars": {
    "PROVIDER_CONFIG": {
      "provider": "alooy",
      "label": "Alooy TV",
      "origin": "https://fa.alooytv16.xyz",
      "sourceOrigins": [
        "https://fa.alooytv16.xyz"
      ],
      "pageHosts": [
        "fa.alooytv16.xyz"
      ],
      "mediaHosts": [
        "*.ujeklsj.site"
      ]
    }
  }
}
